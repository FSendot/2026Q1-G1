# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Variables (allow only example files)
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files (regenerated locally by terraform init)
.terraform.lock.hcl
**/.terraform.lock.hcl

!terraform.tfvars.example

# Secrets and keys
*.pem
*.key
id_rsa*
.env
.env.*

# Editors / IDE
.cursor/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.cursorrules

# Local tooling caches and binaries (per-developer, not shared)
__pycache__/
*.pyc
.pre-commit-cache/
.tools/
.virtualenv-app-data/
.gocache/

# Lambda deployment packages generados por archive_file (data source de Terraform)
**/handler.zip
app/api/build/
app/notification/build/
app/results_writer/build/

# Lambda layers — artefactos de build generados por make build-layers
layers/psycopg2/python/
layers/psycopg2/psycopg2-layer.zip
