# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Variables (allow only example files)
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock files: keep .terraform.lock.hcl committed; ignore everything else under .terraform
!.terraform.lock.hcl
!terraform.tfvars.example

# Secrets and keys
*.pem
*.key
id_rsa*
.env
.env.*

# Editors / IDE
.cursor/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.cursorrules

# Local tooling caches and binaries (per-developer, not shared)
.pre-commit-cache/
.tools/
.virtualenv-app-data/

# Lambda deployment packages generados por archive_file (data source de Terraform)
**/handler.zip
